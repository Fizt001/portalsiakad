{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/",
  "name": "Portal Layanan SIAKAD Terpadu",
  "short_name": "Portal SIAKAD",
  "description": "Gateway Akses Ekosistem SIAKAD Terpadu Yayasan Tinta Emas Indonesia",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#090d16",
  "theme_color": "#090d16",
  "orientation": "any",
  "categories": ["education", "productivity"],
  "icons": [
    {
      "src": "assets/img/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/img/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/img/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/img/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "scope_extensions": [
    { "origin": "https://yatindosystem.net" },
    { "origin": "https://smk.yatindosystem.net" },
    { "origin": "https://smp.yatindosystem.net" },
    { "origin": "https://admsmk.yatindosystem.net" }
  ]
}
